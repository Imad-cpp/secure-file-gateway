APP_NAME="Secure File Gateway"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

AUTH_RATE_LIMIT_PER_MINUTE=5
UPLOAD_RATE_LIMIT_PER_MINUTE=10
DOWNLOAD_RATE_LIMIT_PER_MINUTE=20
DOWNLOAD_CONTENT_RATE_LIMIT_PER_MINUTE=60
DOWNLOAD_URL_TTL_SECONDS=300
API_TOKEN_TTL_MINUTES=720

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=secure_file_gateway
DB_USERNAME=secure_file_gateway
DB_PASSWORD=localdev
DB_SSLMODE=disable

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=90
SESSION_DRIVER=array

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

SCANNER_DRIVER=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_CONNECT_TIMEOUT_SECONDS=3
CLAMAV_READ_TIMEOUT_SECONDS=20
CLAMAV_STREAM_CHUNK_BYTES=8192

FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=localminio
AWS_SECRET_ACCESS_KEY=localminio123
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET_QUARANTINE=sfg-quarantine
AWS_BUCKET_CLEAN=sfg-clean
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# Local development credentials only. Never reuse these values in shared or production environments.
MINIO_ROOT_USER=localminio
MINIO_ROOT_PASSWORD=localminio123
